{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Check images and masks",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/train.py",
      "args": ["--check"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "2. Train U-Net (CPU, 30 epochs)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/train.py",
      "args": ["--device", "cpu", "--epochs", "30"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
